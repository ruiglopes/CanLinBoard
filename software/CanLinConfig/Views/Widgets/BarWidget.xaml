<UserControl x:Class="CanLinConfig.Views.Widgets.BarWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="180" Height="100">
    <Border BorderBrush="#555" BorderThickness="1" CornerRadius="4" Padding="8" Background="#1E1E1E">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding SignalName}" FontSize="11" Foreground="#AAA"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,2">
                <TextBlock Text="{Binding Value, StringFormat=F1}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding Unit}" FontSize="11" Foreground="#888" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
            </StackPanel>
            <Border Grid.Row="2" Background="#333" CornerRadius="2" Height="14" Margin="0,2">
                <Border Background="#0A84FF" CornerRadius="2" HorizontalAlignment="Left">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding NormalizedValue}" ScaleY="1"/>
                    </Border.RenderTransform>
                    <Border.Width>
                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Border}" Mode="OneWay"/>
                    </Border.Width>
                </Border>
            </Border>
            <Grid Grid.Row="3">
                <TextBlock Text="{Binding RangeMin, StringFormat=F0}" FontSize="9" Foreground="#666" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding RangeMax, StringFormat=F0}" FontSize="9" Foreground="#666" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
