<UserControl x:Class="CanLinConfig.Views.Widgets.GaugeWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="180" Height="160">
    <Border BorderBrush="#555" BorderThickness="1" CornerRadius="4" Padding="8" Background="#1E1E1E">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding SignalName}" FontSize="11" Foreground="#AAA"/>
            <Canvas Grid.Row="1" x:Name="GaugeCanvas" Width="140" Height="90" Margin="0,4,0,0">
                <Path x:Name="ArcPath" Stroke="#444" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Line x:Name="Needle" Stroke="#FF3B30" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Ellipse x:Name="CenterDot" Fill="#FF3B30" Width="8" Height="8"/>
            </Canvas>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Value, StringFormat=F1}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding Unit}" FontSize="11" Foreground="#888" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
